# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Database — MySQL / MariaDB. XAMPP's defaults are root with an empty password.
# Create the database once:  CREATE DATABASE wppinbox CHARACTER SET utf8mb4;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wppinbox
DB_POOL_SIZE=10

# Auth — CHANGE BOTH BEFORE DEPLOYING ANYWHERE REAL
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=admin123

# Browser. HEADLESS=false shows the real Chromium driving WhatsApp Web,
# which is the single best way to understand what WPPConnect does.
HEADLESS=true
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Outbound pacing. Sending faster than this is what gets numbers banned.
QUEUE_MIN_DELAY_MS=3000
QUEUE_MAX_DELAY_MS=7000
QUEUE_MAX_ATTEMPTS=3

# Google Sheets for bot steps — see GOOGLE_SHEETS.md
GOOGLE_SERVICE_ACCOUNT_FILE=
